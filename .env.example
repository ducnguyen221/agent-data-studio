# ============================================================================
# agent-data-studio — cấu hình theo máy (.env). KHÔNG COMMIT file .env thật.
# ----------------------------------------------------------------------------
# Cách dùng:
#   1. Đặt biến hệ thống ADS_DATA trỏ thư mục dữ liệu máy (khuyến nghị ~/.data):
#        Windows:  setx ADS_DATA "%USERPROFILE%\.data"
#        macOS/Linux: export ADS_DATA="$HOME/.data"
#   2. Copy file này thành  $ADS_DATA/.env  rồi sửa (installer tự làm nếu chưa có).
#   3. SECRET (Power BI Service) KHÔNG để trong .env — đặt ở file riêng, xem mục [4].
#
# Thứ tự engine nạp: biến hệ thống > $ADS_DATA/.env > $ADS_SECRETS_FILE.
# Biến đã có trong môi trường KHÔNG bị .env ghi đè.
# Mọi tinh chỉnh theo máy đặt ở đây, không nhét vào cấu hình host
# (~/.claude.json, ~/.codex/config.toml) — host chỉ cần PYTHONUNBUFFERED=1.
# ============================================================================


# ---------------------------------------------------------------------------
# [1] VỊ TRÍ — repo, dữ liệu máy, dự án
# ---------------------------------------------------------------------------
# Thư mục dữ liệu máy. Nên đặt bằng biến HỆ THỐNG (setx), vì engine cần nó để
# tìm chính file .env này; dòng dưới chỉ để tài liệu hoá.
# ADS_DATA=C:\Users\<you>\.data

# Thư mục mã nguồn repo (chỉ dùng cho lệnh dev: đồng bộ upstream, distill kit vào repo).
# ADS_REPO=C:\Users\<you>\Code\agent-data-studio

# Thư mục dự án / Knowledge OS: projects/, knowledge/, INDEX.md, TIMELINE.md, policy.json, audit/.
# Luôn NGOÀI repo. Tool `setup_knowledge` tự ghi dòng này (có backup .bak).
# Để trống = agent hỏi trước khi lưu. Gợi ý: $ADS_DATA (dùng luôn projects/ + knowledge/ trong đó).
POWERBI_PROJECT_DIR=

# Kho template kit bổ sung (kit.json + blocks/). Repo đã có kit mặc định.
# POWERBI_TEMPLATES_DIR=C:\Users\<you>\.data\kits

# Nơi ghi kết quả distill model/report (mặc định: <thư mục dự án>/distilled).
# POWERBI_DISTILL_DIR=C:\Users\<you>\.data\out\distilled


# ---------------------------------------------------------------------------
# [2] AN TOÀN DỮ LIỆU — mặc định đã an toàn, chỉ đổi khi hiểu rõ
# ---------------------------------------------------------------------------
# 1 = chỉ trả kết quả tổng hợp; chặn truy vấn dump bảng thô. 0 = tắt (chỉ khi dataset không có PII).
POWERBI_AGGREGATE_ONLY=1

# File policy cột nhạy cảm (blocked_columns). Mặc định: <thư mục dự án>/policy.json.
# Mẫu: policy.example.json trong repo.
# POWERBI_POLICY_FILE=C:\Users\<you>\.data\policy.json

# Nhật ký truy vấn (không chứa dữ liệu). Mặc định: <thư mục dự án>/audit.
# POWERBI_AUDIT_DIR=C:\Users\<you>\.data\audit

# Trần số dòng một truy vấn / trần khi kết quả có cột dimension dạng chữ.
POWERBI_MAX_ROWS=1000
POWERBI_DIMENSION_ROW_CAP=200


# ---------------------------------------------------------------------------
# [3] POWER BI DESKTOP (local) — thường để trống, engine tự dò
# ---------------------------------------------------------------------------
# Thư mục chứa ADOMD.NET / Microsoft.AnalysisServices.Tabular DLL
# (mặc định dò SSMS 19–21, ADOMD.NET standalone, GAC). Chỉ đặt khi `doctor` báo không thấy.
# ADOMD_LIB_DIR=C:\Program Files\Microsoft SQL Server Management Studio 21\Release\Common7\IDE


# ---------------------------------------------------------------------------
# [4] POWER BI SERVICE (cloud) — SECRET ĐỂ FILE RIÊNG
# ---------------------------------------------------------------------------
# Trỏ tới file chứa TENANT_ID / CLIENT_ID / CLIENT_SECRET của Entra ID App (service principal).
# Mặc định: $ADS_DATA/secrets.env. Máy có kho secret riêng thì trỏ vào đó.
# Chỉ cần khi truy vấn dataset trên Power BI Service; bỏ qua nếu chỉ dùng Desktop.
# ADS_SECRETS_FILE=C:\Users\<you>\.secret\powerbi\service.env
#
# Nội dung file secret (ví dụ, KHÔNG điền ở đây):
#   TENANT_ID=<azure-tenant-guid>
#   CLIENT_ID=<entra-app-client-guid>
#   CLIENT_SECRET=<entra-app-client-secret>


# ---------------------------------------------------------------------------
# [5] MICROSOFT — CLI, MCP, skills-for-fabric (ghim version, KHÔNG dùng @latest)
# ---------------------------------------------------------------------------
# Installer và lệnh kiểm tra đọc các giá trị này; để trống = dùng bản đã kiểm trong repo.
# Power BI Desktop Bridge CLI (lệnh `powerbi-desktop`: status/open/reload/screenshot). MIT.
ADS_MS_DESKTOP_BRIDGE_CLI_VERSION=0.1.2
# Power BI Report Authoring CLI (lệnh `powerbi-report-author`: validate/catalog/formatting). MIT.
ADS_MS_REPORT_AUTHORING_CLI_VERSION=0.1.4
# microsoft/skills-for-fabric — tag nguồn của reference Microsoft trong skills/*/references/microsoft/.
ADS_MS_SKILLS_FOR_FABRIC_TAG=v0.3.16
# Power BI Modeling MCP (EULA Microsoft preview — chỉ dùng nội bộ dev/test, không phân phối lại).
# Chỉ bật khi cần thao tác model hàng loạt; tốn nhiều context.
ADS_MS_MODELING_MCP_VERSION=0.5.0-beta.13
# Power BI Desktop tối thiểu để có Desktop Bridge (Options > Preview features >
# "Enable external tool access to Power BI Desktop through secure local APIs").
ADS_MS_MIN_DESKTOP_VERSION=2.155.756.0
