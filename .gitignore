# Secrets — KHÔNG commit (cấu hình nằm ở config.env của trạm; .env ở checkout là cấu hình đời cũ, vẫn chặn)
.env*
!.env.example
config.env
*.credentials.json
auth.json
oauth_creds.json
*.pem
*.key

# Virtual env
.venv/

# Python cache
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Backup do installer tạo
*.bak.*

# Output tạm khi chạy scripts sinh mindmap/excel trong skill
out/

# Tài liệu nội bộ (máy-cá-nhân, client context) — không public
docs/internal/

# Policy thật theo máy/dự án (cột PII nhạy cảm) — không public
policy.json

# Cache tool local
.ruff_cache/
.playwright-cli/

# Con trỏ đời cũ (trước v0.6) — nay cấu hình nằm ở config.env của trạm dữ liệu
knowledge.config.json

# Local planning notes are not part of the public source release
docs/plans/
# Basic workspace and local binding are private machine data
/workspace/
/.ads-binding.json
# Legacy runtime data
lab/
out/
audit/
